<#if interceptor??>
facebook::jsi::Value ${className}::interceptor(facebook::jsi::Runtime& rt, titanium::Proxy* proxy,
	const facebook::jsi::String& property)
{
	facebook::jsi::Value dontIntercept(rt, titanium::TiRuntime::state->dontIntercept);

	<@Hermes.initJNIEnv/>
	<@Hermes.initMethodID className=className name=interceptor.name signature="(Ljava/lang/String;)Ljava/lang/Object;" logOnly=false/>

	jobject javaProxy = proxy->getJavaObject();
	// The Java object is not attached yet while the constructor of the proxy runs.
	if (javaProxy == NULL) {
		return dontIntercept;
	}

	jstring javaProperty = titanium::TypeConverter::jsStringToJavaString(rt, env, property);
	jobject jResult = (jobject) env->CallObjectMethod(javaProxy, methodID, javaProperty);
	proxy->unreferenceJavaObject(javaProxy);
	env->DeleteLocalRef(javaProperty);

	titanium::JSException::checkJavaException(rt, env);

	if (jResult == NULL) {
		return facebook::jsi::Value::null();
	}

	facebook::jsi::Value jsResult = titanium::TypeConverter::javaObjectToJsValue(rt, env, jResult);
	env->DeleteLocalRef(jResult);

	// KrollRuntime.DONT_INTERCEPT tells that the Java proxy does not handle this property.
	if (jsResult.isNumber() && jsResult.getNumber() == (double) titanium::JNIUtil::krollRuntimeDontIntercept) {
